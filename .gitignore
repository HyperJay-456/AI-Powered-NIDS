# ==============================================================================
# Git Ignore Configuration for AI-Powered NIDS Project
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C-extensions
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
bin/
include/
Lib/

# Environment Variables, Secrets & Credentials
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.cert
*.crt

# Streamlit Local Configuration & Secrets
.streamlit/secrets.toml
.streamlit/*.local.toml

# Datasets (Strictly Excluded)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/metadata/*
!data/metadata/.gitkeep
*.db
*.sqlite
*.sqlite3
*.csv
*.parquet
*.feather
*.pcap
*.pcapng
*.h5
*.hdf5
*.tsv
*.zip
*.tar.gz
*.tar
*.bz2
*.7z

# Machine Learning Models & Serialized Binaries (Strictly Excluded)
models/saved/*
!models/saved/.gitkeep
models/evaluations/*
!models/evaluations/.gitkeep
*.pkl
*.joblib
*.onnx
*.pt
*.pth
*.bin
*.model
*.weights

# Runtime Logs
logs/*
!logs/.gitkeep
*.log

# Unit Test & Coverage Caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Type Checking & Linting Caches
.mypy_cache/
.ruff_cache/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDEs and Text Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
